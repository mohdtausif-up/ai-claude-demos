APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# Host port for the nginx container.
APP_PORT=8080
# 64 hex chars. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me-to-64-hex-characters

DB_HOST=db
DB_PORT=3306
DB_DATABASE=ssshare
DB_USERNAME=ssshare
DB_PASSWORD=ssshare
DB_ROOT_PASSWORD=rootsecret

# local | s3. Regional buckets: S3_BUCKET_EU, S3_BUCKET_US (used by workspace storage regions).
STORAGE_DRIVER=local
S3_ENDPOINT=http://s3:9000
S3_REGION=us-east-1
S3_BUCKET=ssshare
S3_KEY=ssshare
S3_SECRET=ssshare-secret
S3_PATH_STYLE=true
# Local RustFS only: base64 32-byte key enabling server-side encryption.
S3_SSE_MASTER_KEY=

# smtp | log. Mailpit (docker compose) captures mail at http://localhost:8025
MAIL_TRANSPORT=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@ssshare.local

# Billing webhook signing secret (provider-agnostic HMAC; Stripe-compatible header format).
BILLING_WEBHOOK_SECRET=change-me

# Optional: enables AI summaries / AI redaction where a workspace has opted in.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANONYMOUS_UPLOADS=true

# Created by `php bin/migrate.php --seed` if set.
ADMIN_EMAIL=admin@ssshare.local
ADMIN_PASSWORD=change-me-admin-password

# Optional ClamAV daemon (host:port). Leave empty to use the built-in heuristic scanner only.
CLAMAV_HOST=
BILLING_CHECKOUT_URL=
# Development only: allow webhook targets on private networks.
WEBHOOKS_ALLOW_PRIVATE=false

# Coarse viewer-country analytics: name the header your CDN/edge sets (e.g. CF-IPCountry).
# Leave empty unless a trusted proxy always sets/overwrites it; clients can forge it otherwise.
ANALYTICS_COUNTRY_HEADER=
# URL capture egress: by default only public IPs on ports 80/443 are reachable.
# CAPTURE_ALLOW_HOSTS=intranet.example.com  # comma-separated hosts exempt from the private-IP block (trusted only)

# Encrypted backups (php bin/backup.php create|verify|restore|prune). Generate with: openssl rand -base64 32
# Store a copy offline: without it backups cannot be restored. Restores also need the same APP_KEY.
BACKUP_KEY=
BACKUP_KEEP_DAYS=7
