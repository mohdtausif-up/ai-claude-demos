"Custom scalars: Date comes from graphql-java-extended-scalars, Email is implemented in this project."
scalar Date
scalar Email

"Custom schema directive, implemented in config/UpperCaseDirective.java"
directive @upper on FIELD_DEFINITION

enum Genre {
    FICTION
    SCIENCE_FICTION
    FANTASY
    HISTORY
    TECH
}

enum BookOrder {
    TITLE
    PUBLISHED
    PAGES
}

"Interface: shared fields of all persisted types"
interface Node {
    id: ID!
}

type Author implements Node {
    id: ID!
    name: String!
    "Same value as name, upper-cased by the @upper directive"
    shoutName: String! @upper
    email: Email
    born: Date
    "Resolved with @BatchMapping (DataLoader) - no N+1 queries"
    books: [Book!]!
}

type Book implements Node {
    id: ID!
    title: String!
    genre: Genre!
    published: Date
    pages: Int
    author: Author!
    reviews: [Review!]!
    legacyCode: String @deprecated(reason: "Use id instead")
}

type Review implements Node {
    id: ID!
    rating: Int!
    comment: String
    book: Book!
}

"Union: a search can return different, unrelated types"
union SearchResult = Author | Book | Review

input BookFilter {
    genre: Genre
    titleContains: String
    minPages: Int
}

input AuthorInput {
    name: String!
    email: Email
    born: Date
}

input BookInput {
    title: String!
    genre: Genre!
    published: Date
    pages: Int
    authorId: ID!
}

input BookUpdateInput {
    title: String
    genre: Genre
    published: Date
    pages: Int
}

input ReviewInput {
    bookId: ID!
    rating: Int!
    comment: String
}

type Query {
    "Arguments with default values"
    hello(name: String = "World"): String!
    "Value read from the GraphQL context, filled from the X-User HTTP header by an interceptor"
    whoami: String!
    "Nullable result: returns null when the id does not exist"
    book(id: ID!): Book
    "Non-null result: a missing id produces a NOT_FOUND error"
    requireBook(id: ID!): Book!
    "Filtering and ordering"
    books(filter: BookFilter, orderBy: BookOrder = TITLE): [Book!]!
    "Relay cursor connection (BookConnection / BookEdge / PageInfo are generated by Spring GraphQL)"
    booksConnection(first: Int, after: String, last: Int, before: String): BookConnection!
    authors: [Author!]!
    author(id: ID!): Author
    search(text: String!): [SearchResult!]!
}

type Mutation {
    addAuthor(input: AuthorInput!): Author!
    addBook(input: BookInput!): Book!
    updateBook(id: ID!, input: BookUpdateInput!): Book
    deleteBook(id: ID!): Boolean!
    addReview(input: ReviewInput!): Review!
}

type Subscription {
    "Emits every new book, optionally only of one genre"
    bookAdded(genre: Genre): Book!
    "Emits every new review of one book"
    reviewAdded(bookId: ID!): Review!
}
