APP_ENV=local
APP_NAME=Invite.com
APP_URL=http://localhost:8480
# 64 hex chars. Signs guest/QR/unsubscribe tokens. Rotating it invalidates all personal links.
APP_KEY=
APP_PORT=8480

DB_HOST=db
DB_PORT=3306
DB_DATABASE=invite
DB_USERNAME=invite
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Host-side port for connecting with a MySQL client (non-default on purpose).
DB_FORWARD_PORT=33061

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@invite.test
MAIL_FROM_NAME=Invite.com
MAILPIT_PORT=8425

# Registering with this address makes the account a platform admin.
ADMIN_EMAIL=admin@invite.test

# Shared secret for POST /webhooks/email-bounce
BOUNCE_WEBHOOK_SECRET=

# Days a deleted event is kept (recoverable) before it is purged. See docs/RETENTION.md
RETENTION_DAYS=30

# 1 = log every 4xx with its source line (development only)
APP_DEBUG=0

# Allow webhook targets on private networks (development only; leave 0 in production to block SSRF)
WEBHOOK_ALLOW_PRIVATE=0

# Sign in with Google / Microsoft (leave empty to hide the buttons). Redirect URI: <APP_URL>/auth/google/callback and /auth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Development-only identity provider served by this app (needs APP_ENV=local)
OAUTH_MOCK=0

# Plan for workspaces without one assigned: free | plus | pro | agency (billing is not built in; admins assign plans)
DEFAULT_PLAN=free
